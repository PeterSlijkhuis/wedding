{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wedding",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Every request passes the password check in the worker before a static file is served.
    "run_worker_first": true
  },
  // Photo files live in KV (free, no card needed); the photos table in D1 is just the ordered list of ids.
  "kv_namespaces": [{ "binding": "PHOTOS" }],
  "d1_databases": [
    { "binding": "DB", "database_name": "wedding", "migrations_dir": "migrations" }
  ],
  // This is the live site. SITE_STAGE tells the admin which site it is on.
  "vars": { "SITE_STAGE": "live" },
  "env": {
    // The test site: its own Worker, database and photos, deployed from the development branch.
    "test": {
      "name": "wedding-test",
      "vars": { "SITE_STAGE": "test" },
      "kv_namespaces": [{ "binding": "PHOTOS" }],
      "d1_databases": [
        { "binding": "DB", "database_name": "wedding-test", "migrations_dir": "migrations" }
      ]
    }
  }
}

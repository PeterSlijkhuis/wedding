{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wedding",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Every request passes the password check in the worker before a static file is served.
    "run_worker_first": true
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "wedding", "migrations_dir": "migrations" }
  ]
}
